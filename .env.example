# Sao chép file này thành `.env` rồi điền giá trị thật. `.env` đã được gitignore.

# ---- Database (Postgres, local dev) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=merchant_platform
DB_HOST=localhost
DB_PORT=5432

# ---- LLM providers (OpenAI-compatible: base_url + api_key + model_id) ----
# NVIDIA NIM — key tại https://build.nvidia.com (dạng "nvapi-")
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Model id CHÍNH XÁC, ví dụ: qwen/qwen3-235b-a22b
NIM_MODEL=

# FPT Cloud AI — base_url + key + đúng 2 model id (Qwen, DeepSeek)
FPT_API_KEY=
FPT_BASE_URL=
FPT_MODEL_QWEN=
FPT_MODEL_DEEPSEEK=
