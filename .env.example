# Sao chép file này thành `.env` rồi điền key thật. `.env` đã được gitignore.
# Client dùng chuẩn OpenAI-compatible: cần base_url + api_key + model_id cho mỗi provider.

# ---- NVIDIA NIM ----
# Lấy key tại https://build.nvidia.com (API key bắt đầu bằng "nvapi-")
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Model id CHÍNH XÁC (copy từ trang model trên build.nvidia.com), ví dụ dạng: qwen/qwen3-235b-a22b
NIM_MODEL=

# ---- FPT Cloud AI ----
# Điền base_url + key + đúng 2 model id (Qwen và DeepSeek) từ FPT Cloud AI console
FPT_API_KEY=
FPT_BASE_URL=
FPT_MODEL_QWEN=
FPT_MODEL_DEEPSEEK=
