# Sao chép file này thành `.env` rồi điền giá trị thật. `.env` đã được gitignore.

# ---- Database (Postgres, local dev) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=merchant_platform
DB_HOST=localhost
DB_PORT=5432

# ---- Active LLM (one provider at a time) ----
# Shared runtime keys consumed by Merchant Advisor.  Providers with an
# OpenAI-compatible endpoint (Fireworks, Gemini compatibility API, FPT, NIM)
# must set LLM_PROVIDER=openai_compatible; runtime then uses provider=openai.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_SMALL=
LLM_MODEL_LARGE=

# ---- Green SM Policy RAG (OpenAI-compatible embeddings + local Chroma) ----
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHROMA_PATH=.runtime/policy-rag
RAG_COLLECTION=green-sm-policy
RAG_SCORE_THRESHOLD=0.6

# ---- Unified Mem0 runtime ----
MEM0_IMAGE=vsf-mem0:v2.0.18-custom.1
MEM0_DASHBOARD_IMAGE=vsf-mem0-dashboard:v2.0.18-custom.1
MEM0_PORT=8888
MEM0_DASHBOARD_PORT=3000
REDIS_HOST_PORT=6381
POSTGRES_COLLECTION_NAME=memories
ADMIN_API_KEY=
JWT_SECRET=
AUTH_DISABLED=false
MEM0_TELEMETRY=false
MEM0_DISABLE_RESPONSE_FORMAT=true

LANGFUSE_SECRET_KEY="sk-lf-**************"
LANGFUSE_PUBLIC_KEY="pk-lf-**************"
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"
